# Local Supabase only. Get the publishable key from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_ADMIN_LOGIN_EMAIL=replace-with-supabase-auth-email
NEXT_PUBLIC_SUPABASE_CAPTCHA_SITE_KEY=
NEXT_PUBLIC_ALGOLIA_APP_ID=replace-with-algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=replace-with-algolia-search-only-key
NEXT_PUBLIC_ALGOLIA_PRODUCTS_INDEX=outjourney_products

# Server-only Algolia indexing key. Never expose this key to the browser.
ALGOLIA_APP_ID=replace-with-algolia-app-id
ALGOLIA_ADMIN_API_KEY=replace-with-algolia-admin-api-key
ALGOLIA_PRODUCTS_INDEX=outjourney_products

# Server-only @supabase/server configuration. Never expose the secret key to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Server-only SMTP settings. Never expose these in NEXT_PUBLIC_ variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME=PT Outjourney
